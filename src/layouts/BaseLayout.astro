---
import '../styles/global.css';
import { links } from '../content/links';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/horizon-banner.png', Astro.site);
const organizationUrl = new URL('/', Astro.site);
const organizationLogo = new URL('/horizon.png', Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Horizon Collective',
  url: organizationUrl.href,
  description,
  logo: {
    '@type': 'ImageObject',
    url: organizationLogo.href,
    contentUrl: organizationLogo.href,
    width: 640,
    height: 160,
    caption: 'Horizon Collective',
  },
  image: socialImage.href,
  email: links.contact.ruudEmail,
  contactPoint: {
    '@type': 'ContactPoint',
    email: links.contact.ruudEmail,
    contactType: 'general inquiries',
    availableLanguage: ['English'],
  },
  founder: [
    {
      '@type': 'Person',
      name: 'Robyn Agoston',
      url: links.organizations.workEvolved,
      sameAs: [
        links.people.robynLinkedIn,
        links.people.robynSubstack,
      ],
    },
    {
      '@type': 'Person',
      name: 'Ruud Rikhof',
      url: links.organizations.brooksmiller,
      sameAs: [links.people.ruudLinkedIn],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#47093D" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/hero-art-clean.webp" as="image" type="image/webp" fetchpriority="high" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Horizon Collective" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Horizon Collective — The world of work is being rewritten." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Horizon Collective — The world of work is being rewritten." />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
